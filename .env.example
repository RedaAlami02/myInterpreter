# myInterpreter — environment configuration (EXAMPLE / placeholders only)
# Copy to `.env` (and set the same values as Appwrite Cloud Function variables).
# Never commit real values. `.env` is gitignored.

# --- Appwrite (used by the Python Cloud Functions: cloud_function/) ---
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_server_api_key   # server key with documents.read/write — keep secret

# --- Upstream market data (bring your own) ---
# This project reads prices, fundamentals and a dividend calendar from three
# third-party APIs. None of them are bundled: clone the repo and point it at
# whatever you have access to.
#
# Preferred: copy each function's sources.example.py to sources.py and fill it
# in. sources.py is gitignored but the Appwrite CLI still uploads it, because
# it packages the whole function directory. On the PHP side the equivalent is
# config/sources.php, copied from config/sources.example.php — index.php and
# handlers/market_proxy.php fatal without it, so upload it to the host by hand.
#
# Fallback: if a function has no sources.py it reads these instead, so you can
# configure it entirely from Console → Functions → Settings → Variables.
MARKET_API_URL=https://example.invalid/api/          # getprice — live quotes
MARKET_ORIGIN=https://example.invalid                # sent as Origin/Referer
FUNDAMENTALS_BASE=https://example.invalid/api/proxy  # onboard_company — accounts
FUNDAMENTALS_ORIGIN=https://example.invalid
FUNDAMENTALS_SUPABASE=https://example.invalid/api/proxy/supabase  # dividends cross-check
CALENDAR_URL=https://example.invalid/calendrier-des-dividendes/annee/{year}/
CALENDAR_SOURCE_NAME=calendar   # written to the `source` field of dividend rows

# --- PHP web frontend ---
# The PHP app reads its server API key from config/secrets.php (gitignored), not from .env.
# Create config/secrets.php from this template:
#   <?php
#   define('APPWRITE_API_KEY', 'your_appwrite_server_api_key');
# The endpoint and project ID are non-secret constants in core/Appwrite.php.
#
# Note: there are NO database credentials — the app uses the Appwrite REST API,
# not a direct MySQL/SQL connection. (migrate.py is a local one-off import tool.)
