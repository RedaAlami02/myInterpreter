# Copy to .supabase-migration.env and fill locally. The real file is gitignored.
# Keep database passwords and secret keys out of chat and version control.

# Project URL from the Supabase project's Connect/API settings.
SUPABASE_PROJECT_URL=

# PostgreSQL URI from Connect > Session pooler. Use the database password,
# correctly URL-encoded. Keep SSL enabled; append sslmode=require if needed.
SUPABASE_DATABASE_URL=

# Public application key, needed later when connecting PHP and Flutter.
SUPABASE_PUBLISHABLE_KEY=

# Server-only API key, used later for account migration and trusted automation.
SUPABASE_SECRET_KEY=
